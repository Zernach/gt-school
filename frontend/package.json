{
  "name": "@keystone/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && tsc -p functions/tsconfig.json --pretty false && vite build",
    "typecheck": "tsc -b --pretty false",
    "typecheck:pages": "tsc -p functions/tsconfig.json --pretty false",
    "types:pages": "wrangler types functions/worker-configuration.d.ts",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "26.2.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitest/coverage-v8": "latest",
    "jsdom": "29.1.1",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "vitest-axe": "latest"
  }
}
