# Copy this file to backend/docker/.env before changing local defaults.
# API_IMAGE can be any image. Set API_CONTAINER_PORT to its listening port.
API_IMAGE=traefik/whoami:v1.10
API_PORT=8080
API_CONTAINER_PORT=80
POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_DB=app
POSTGRES_USER=app
# Local-only default. Replace before using this stack beyond local development.
POSTGRES_PASSWORD=app
QUEUE_IMAGE=redis:7-alpine
